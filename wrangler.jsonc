// ============================================================================
// Cloudflare Workers deploy configuration for soumik.me
//
// This is a pure static site — no build step. Wrangler uploads everything in
// ./public (and only that folder) and serves it as static assets.
//
// If your Cloudflare Worker uses a different name, update `name` below to
// match the dashboard.
// ============================================================================

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soumik-me",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },

  // Observability — matches the settings Cloudflare prints on deploy
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
